# ==============================================
# FLOWTRACK/WALER - Configuration Template
# ==============================================
# 
# INSTRUCTIONS:
# 1. Copiez ce fichier et renommez-le en ".env"
# 2. Remplacez les valeurs par vos vraies credentials
# 3. Ne commitez JAMAIS le fichier .env dans Git!
#
# ==============================================

# ==============================================
# DATABASE - SUPABASE POSTGRESQL (REQUIS)
# ==============================================
# Obtenez votre connection string depuis:
# https://supabase.com/dashboard → Settings → Database → Connection string
# 
# IMPORTANT: Remplacez [YOUR-PASSWORD] par votre vrai mot de passe!
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ==============================================
# SERVER (REQUIS)
# ==============================================
PORT=5000

# Générez un secret aléatoire avec:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret-in-production

# ==============================================
# INSTAGRAM AGENTS (Optionnel pour commencer)
# ==============================================
# Agent A - Détecteur d'unfollows
AGENT_A_INSTAGRAM_USER=your_instagram_username
AGENT_A_INSTAGRAM_PASS=your_instagram_password
VITE_AGENT_A_INSTAGRAM_USER=your_instagram_username

# Agent B - Vérification de comptes (bloqués/supprimés)
# Utilisez un compte DIFFÉRENT de l'Agent A
AGENT_B_INSTAGRAM_USER=your_second_instagram_username
AGENT_B_INSTAGRAM_PASS=your_second_instagram_password
VITE_AGENT_B_INSTAGRAM_USER=your_second_instagram_username

# Agent C - Tracker de followers pour clients Pro (Optionnel)
AGENT_C_INSTAGRAM_USER=your_third_instagram_username
AGENT_C_INSTAGRAM_PASS=your_third_instagram_password

# Agent Waler - Vérification & Communication
AGENT_WALER_INSTAGRAM_USER=your_waler_instagram_username
AGENT_WALER_INSTAGRAM_PASS=your_waler_instagram_password

# Compte officiel Waler - Pour 2FA
WALER_OFFICIAL_USER=waler_official
WALER_OFFICIAL_PASS=your_waler_official_password

# ==============================================
# STRIPE - Paiements (Optionnel)
# ==============================================
# Obtenez vos clés depuis: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# IDs de prix Stripe (créez des produits dans le Dashboard Stripe)
STRIPE_PRICE_BASE_MONTHLY=price_xxx_base_monthly
STRIPE_PRICE_BASE_YEARLY=price_xxx_base_yearly
STRIPE_PRICE_PRO_MONTHLY=price_xxx_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_xxx_pro_yearly

# ==============================================
# NOTES
# ==============================================
# 
# MINIMUM REQUIS pour démarrer:
# - DATABASE_URL (Supabase)
# - SESSION_SECRET
# 
# Les autres variables sont optionnelles et peuvent être
# configurées plus tard selon vos besoins.
#
# ==============================================
