# ==============================================
# WALER - Configuration Template
# ==============================================
#
# INSTRUCTIONS:
# 1. Copiez ce fichier et renommez-le en ".env"
# 2. Remplacez les valeurs par vos vraies credentials
# 3. Ne commitez JAMAIS le fichier .env dans Git!
#
# ==============================================

# ==============================================
# DATABASE - SUPABASE POSTGRESQL (REQUIS)
# ==============================================
# Obtenez votre connection string depuis:
# https://supabase.com/dashboard → Settings → Database → Connection string
#
# IMPORTANT: Remplacez [YOUR-PASSWORD] par votre vrai mot de passe!
DATABASE_URL=postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ==============================================
# SERVER (REQUIS)
# ==============================================
PORT=5000

# Générez un secret aléatoire avec:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Clé de chiffrement AES-256 des contenus de messages DM stockés (au repos).
# REQUIS en production. Générez une clé hex 32 octets avec:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Ne changez JAMAIS cette clé après collecte: les messages déjà chiffrés
# deviendraient illisibles.
DM_ENCRYPTION_KEY=change-this-to-a-32-byte-hex-key-in-production

# ==============================================
# STRIPE - Paiements (Optionnel)
# ==============================================
# Obtenez vos clés depuis: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# IDs de prix Stripe (créez des produits dans le Dashboard Stripe)
STRIPE_PRICE_BASE_MONTHLY=price_xxx_base_monthly
STRIPE_PRICE_BASE_YEARLY=price_xxx_base_yearly
STRIPE_PRICE_PRO_MONTHLY=price_xxx_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_xxx_pro_yearly

# ==============================================
# NOTES
# ==============================================
#
# MINIMUM REQUIS pour démarrer:
# - DATABASE_URL (Supabase)
# - SESSION_SECRET
#
# Les autres variables sont optionnelles et peuvent être
# configurées plus tard selon vos besoins.
#
# ==============================================
