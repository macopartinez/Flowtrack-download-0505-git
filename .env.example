# ==============================================
# FLOWTRACK/WALER - Configuration
# ==============================================

# Database - Supabase PostgreSQL
# Get your connection URL from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Instagram Agent A - Unfollow Detector
# Main account to monitor unfollows
AGENT_A_INSTAGRAM_USER=your_instagram_username
AGENT_A_INSTAGRAM_PASS=your_instagram_password
VITE_AGENT_A_INSTAGRAM_USER=your_instagram_username

# Instagram Agent B - Account Verification (blocked/deleted)
# Use a DIFFERENT Instagram account from Agent A
AGENT_B_INSTAGRAM_USER=your_second_instagram_username
AGENT_B_INSTAGRAM_PASS=your_second_instagram_password
VITE_AGENT_B_INSTAGRAM_USER=your_second_instagram_username

# Instagram Agent C - Pro Clients Follower Tracker (Optional for Pro plan)
# Use a DIFFERENT Instagram account from Agent A and B
AGENT_C_INSTAGRAM_USER=your_third_instagram_username
AGENT_C_INSTAGRAM_PASS=your_third_instagram_password

# Instagram Agent Waler - Verification & Communication
# Account that receives verification codes and responds to users
AGENT_WALER_INSTAGRAM_USER=your_waler_instagram_username
AGENT_WALER_INSTAGRAM_PASS=your_waler_instagram_password

# Server
PORT=5000

# Session Secret - IMPORTANT: Change this in production!
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Waler Official Account - For 2FA verification
# This account receives verification messages from users
WALER_OFFICIAL_USER=waler_official
WALER_OFFICIAL_PASS=your_waler_official_password

# Stripe - Payment processing
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create products in Stripe Dashboard)
STRIPE_PRICE_BASE_MONTHLY=price_xxx_base_monthly
STRIPE_PRICE_BASE_YEARLY=price_xxx_base_yearly
STRIPE_PRICE_PRO_MONTHLY=price_xxx_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_xxx_pro_yearly

# ==============================================
# SUPABASE SETUP INSTRUCTIONS
# ==============================================
# 
# 1. Create an account at https://supabase.com
# 2. Create a new project
# 3. Go to Settings > Database
# 4. Copy the "Connection string" (Transaction or Session mode)
# 5. Replace [YOUR-PASSWORD] with your database password
# 6. Paste the URL in DATABASE_URL above
#
# Example:
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YourPassword123!@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#
# ==============================================
